# Never commit the real .env file or paste these tokens into source code.
HF_TOKEN=hf_your_token_here
NGROK_AUTH_TOKEN=your_ngrok_token_here

# Replace these example paths with the paths created by your Kaggle datasets.
DPO_CHECKPOINT=/kaggle/input/YOUR_DATASET/checkpoints/medgemma_4b/final
VERIFIER_CHECKPOINT=/kaggle/input/YOUR_DATASET/verifier/classifier_head.pth
SAMPLE_IMAGES_DIR=/kaggle/input/YOUR_DATASET/kvasir_vqa_final/images
IMAGE_LABELS_PATH=/kaggle/input/YOUR_DATASET/kvasir_vqa_final/metadata/image_labels.json

# Comma-separated frontend origins. Add your deployed frontend URL if needed.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8000
ENABLE_NGROK=true
